{
  "name": "biovalidator",
  "version": "2.2.2",
  "description": "A nodejs JSON schema validator, extended from Ajv to include ontology validation.",
  "main": "src/biovalidator.js",
  "bin": {
    "biovalidator": "src/biovalidator.js"
  },
  "repository": "https://github.com/elixir-europe/biovalidator.git",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "start": "node src/biovalidator.js",
    "test": "npm run test:internal",
    "test:internal": "jest --config jest.internal.config.js",
    "test:external": "jest --config jest.external.config.js",
    "test:external:ena": "jest --config jest.external.config.js test/external/ena.test.js",
    "test:external:identifiers": "jest --config jest.external.config.js test/external/identifiers.test.js",
    "test:external:ols": "jest --config jest.external.config.js test/external/ols.test.js",
    "test:external:github": "jest --config jest.external.config.js test/external/github.test.js",
    "test-watch": "nodemon --exec \"npm run test:internal\"",
    "travis-test": "npm run test:internal -- test/validator.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.8.2",
  "keywords": [
    "nodejs",
    "json",
    "schema",
    "validator"
  ],
  "author": "EMBL-EBI-AIT, fpenim, ke4, haseeb-gh, theisuru",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "2.1.1",
    "axios": "^1.19.0",
    "express": "^4.22.2",
    "glob": "^13.0.6",
    "node-cache": "^5.1.2",
    "npid": "^0.4.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "bootstrap": "^5.3.8",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "rollup": "^3.30.0",
    "supertest": "^7.2.2",
    "terser": "^5.50.0",
    "ts-node": "^9.1.0",
    "typescript": "^4.1.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
